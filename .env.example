# ReAround You · 环境变量清单
# 本地：复制为 .env.local（不会提交到 git）。生产：在托管平台的环境变量里配置。
# 值全部留空，不要把真实密钥提交进仓库。部署说明见 docs/DEPLOYMENT.md

# ===== 必需：大模型（讲解 / 随手问 / 路线 / 拍照识别），任何 OpenAI 兼容接口都行 =====
# 智谱（目前 Beta 在用，免费额度）：
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
# 主模型被限流（429）时自动换的备用模型；用智谱时不填默认 glm-4-flash-250414
# LLM_FALLBACK_MODEL=glm-4-flash-250414
# 拍照识别用的多模态模型；用智谱时不填默认 glm-4v-flash（免费）
# LLM_VISION_MODEL=glm-4v-flash
#
# 换 Gemini（免费档）示例：
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# ===== 必需（生产）：Upstash Redis —— 邮箱登记 + 按 IP 限流 =====
# Vercel Marketplace 一键创建后自动注入；自建时填 Upstash 控制台里的 REST URL / Token
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== 域名分流（生产）=====
# 官网域名（逗号分隔）。配了以后这些域名的根路径显示官网（内部重写到 /site），/privacy /terms 也可直接访问
SITE_HOSTS=bubblefrog.fun,www.bubblefrog.fun
# 官网按钮指向的应用地址（应用子域名根路径就是应用，不需要额外配置）
NEXT_PUBLIC_APP_URL=https://app.bubblefrog.fun

# ===== 官网上的安卓安装包下载（可选；不配就显示 coming soon）=====
# 例如 NEXT_PUBLIC_APK_URL=/downloads/ReAroundYou-1.1.apk（文件放 public/downloads/）或任意 https 地址
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_APK_VERSION=

# ===== 可选 =====
# 高德地图 Web 服务 Key，仅中国境内周边数据；面向海外可不配
# AMAP_KEY=
# 语音提问：任何 OpenAI 兼容的 /audio/transcriptions 接口，没配就不显示「按住说话」
# Groq（全球，免费额度）：
# ASR_BASE_URL=https://api.groq.com/openai/v1
# ASR_API_KEY=
# ASR_MODEL=whisper-large-v3-turbo
# 限流覆盖，格式「次数/秒」，桶名 GUIDE ASK PLAN IDENTIFY TRANSCRIBE TTS SIGNUP；默认值见 lib/ratelimit.ts
# RATE_LIMIT_TTS=600/600
# RATE_LIMIT_OFF=1   # 整体关闭（只用于本地开发或内部压测）

# ===== 打包安卓时（构建期变量，运行时不用）=====
# CAP_SERVER_URL=https://app.bubblefrog.fun

# ===== 本机开发走代理时（服务器上不需要）=====
# NODE_USE_ENV_PROXY=1
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# 国内服务（智谱、高德）不要走代理，代理出口 IP 会被限流
# NO_PROXY=localhost,127.0.0.1,open.bigmodel.cn,restapi.amap.com
