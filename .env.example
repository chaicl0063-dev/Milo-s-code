# 复制为 .env.local 后按需修改。.env.local 不会被提交到 git。

# --- 本地代理（可选）---
# 如果你的网络访问 Wikipedia 需要代理，打开下面四行并改成你的代理地址。
# NODE_USE_ENV_PROXY=1
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# 国内服务（智谱、高德）不要走代理，代理出口 IP 会被限流
# NO_PROXY=localhost,127.0.0.1,open.bigmodel.cn,restapi.amap.com

# --- LLM（AI 讲解）--- 任何 OpenAI 兼容接口都行
# 智谱（免费）：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=
# LLM_MODEL=glm-4.7-flash
# 主模型被限流时自动换的备用模型；用智谱时不填默认 glm-4-flash-250414
# LLM_FALLBACK_MODEL=glm-4-flash-250414
#
# Gemini（免费档）示例：
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# --- 高德地图（可选，仅中国境内生效）---
# 高德开放平台 → 应用管理 → 添加「Web服务」类型的 Key。没有就跳过高德数据源。
# AMAP_KEY=

# --- 拍照识别 ---（可选）多模态模型；用智谱时不填默认 glm-4v-flash（免费）
# LLM_VISION_MODEL=glm-4v-flash

# --- 语音提问 ---（可选）任何 OpenAI 兼容的 /audio/transcriptions 接口，没配就不显示「按住说话」
# Groq（全球，免费额度）：
# ASR_BASE_URL=https://api.groq.com/openai/v1
# ASR_API_KEY=
# ASR_MODEL=whisper-large-v3-turbo
# 硅基流动（国内，有免费模型）：
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
